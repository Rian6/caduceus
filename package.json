{
  "name": "roms-desktop",
  "version": "1.1.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && tsc -p tsconfig.electron.json && electron .\"",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never",
    "migrate:mongo": "node scripts/migrate-mongo.mjs",
    "import:mongo": "node scripts/import-mongo.mjs",
    "catalog:check": "node scripts/check-catalog.mjs"
  },
  "dependencies": {
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "typescript": "latest",
    "wait-on": "latest",
    "electron-builder": "latest",
    "vite": "latest",
    "@vitejs/plugin-react": "latest",
    "electron": "latest",
    "mongodb": "^6.20.0"
  },
  "build": {
    "appId": "br.com.ps2library.app",
    "productName": "Caduceus",
    "directories": {
      "output": "release"
    },
    "artifactName": "Caduceus-Setup-${version}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/xerabora",
        "to": "xerabora",
        "filter": [
          "xerabora-caduceus.exe",
          "caduceus.patch",
          "OPL-RA.ELF",
          "LICENSE-*.txt",
          "SHA256SUMS",
          "CADUCEUS-SHA256SUMS",
          "README.md"
        ]
      },
      {
        "from": "oplserver",
        "to": "oplserver",
        "filter": [
          "OPLServer.exe",
          "OPLServer.config",
          "SMBLibrary.dll",
          "SMBLibrary.Win32.dll",
          "Utilities.dll"
        ]
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "public/ps2-splash.png",
        "to": "ps2-splash.png"
      },
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "electron/native",
        "to": "opl-activity",
        "filter": [
          "*.ps1",
          "*.cs"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/installer-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Caduceus",
      "installerIcon": "build/installer-icon.ico",
      "uninstallerIcon": "build/installer-icon.ico",
      "runAfterFinish": true
    }
  },
  "description": "Gerenciador de jogos PlayStation 2 com integração ao OPL e catálogo SQLite local",
  "author": "Rian Mendes"
}
